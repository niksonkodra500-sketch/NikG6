{
  "name": "nikg6-photo-editor",
  "private": true,
  "version": "2.2.6",
  "type": "module",
  "description": "Photo editing app with built-in AI assistant (Android-first, Capacitor)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cap:add:android": "npx cap add android",
    "cap:sync:android": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "gen:sample": "node scripts/generate-sample.mjs",
    "dev:android": "npm run dev -- --host 0.0.0.0 --strictPort",
    "cap:run:android": "npx cap run android --live-reload --port 5173",
    "cap:run:android:usb": "npx cap run android --live-reload --host localhost --port 5173 --forwardPorts 5173:5173"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "capacitor-secure-storage-plugin": "^0.10.0",
    "fabric": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
