{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "anthropic/claude-opus-5.5",
  "small_model": "anthropic/claude-opus-5.5",
  "default_agent": "general",
  "agent": {
    "swarm": {
      "mode": "parallel"
    },
    "general": {
      "description": "Primary coding agent for the photo editor project",
      "mode": "primary",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0.1,
      "top_p": 0.95,
      "color": "primary"
    },
    "explore": {
      "description": "Fast codebase exploration and research",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0,
      "color": "info"
    },
    "build": {
      "description": "Build and release automation",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "success"
    },
    "photo-editor": {
      "description": "Specialized agent for photo editor development tasks",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "accent"
    },
    "debug": {
      "description": "Debugging and troubleshooting specialist",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0,
      "color": "warning"
    },
    "review": {
      "description": "Code review and quality assurance",
      "mode": "subagent",
      "model": "anthropic/claude-opus-5.5",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "secondary"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 999999999,
    "preserve_recent_tokens": 999999999,
    "reserved": 999999999,
    "memory": true,
    "memory_infinity": true,
    "memory_unlimited": true,
    "memory_no_limit": true,
    "memory_maximal": true,
    "memory_maximal_capacity": 9007199254740991,
    "memory_infinite_capacity": 9007199254740991,
    "memory_unlimited_capacity": 9007199254740991,
    "memory_capacity_max": 9007199254740991,
    "memory_capacity_infinity": 9007199254740991,
    "memory_heap_max": 9007199254740991,
    "memory_heap_infinity": true,
