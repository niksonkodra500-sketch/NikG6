{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "small_model": "kilo/kilo-auto/free",
  "default_agent": "general",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 20,
    "preserve_recent_tokens": 8000,
    "reserved": 4000
  },
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "username": "niksonkodra500",
  "shell": "bash",
  "logLevel": "INFO",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "doom_loop": "allow",
    "notebook_read": "allow",
    "notebook_edit": "allow",
    "notebook_execute": "allow"
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "${OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 60000,
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      }
    }
  },
  "disabled_providers": ["openai", "anthropic", "google", "groq", "cohere"],
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspace/app"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "NODE_ENV": "development"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.github.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "enabled": false,
      "timeout": 30000
    }
  },
  "skills": {
    "paths": ["./.kilo/skills", "~/.config/kilo/skills"],
    "urls": []
  },
  "instructions": [".kilo/plans/*.md", "AGENTS.md", "CLAUDE.md", "CONTEXT.md"],
  "plugin": [],
  "references": {
    "nikg6-repo": {
      "repository": "https://github.com/niksonkodra500-sketch/NikG6",
      "branch": "kilo/live-copper-nwe",
      "description": "NikG6 Photo Editor main repository"
    }
  },
  "agent": {
    "general": {
      "description": "Primary coding agent for the photo editor project",
      "mode": "primary",
      "model": "kilo/kilo-auto/free",
      "steps": 50,
      "temperature": 0.1,
      "top_p": 0.95,
      "color": "primary"
    },
    "explore": {
      "description": "Fast codebase exploration and research",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 10,
      "temperature": 0.0,
      "color": "info"
    },
    "build": {
      "description": "Build and release automation",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 30,
      "temperature": 0.1,
      "color": "success"
    },
    "photo-editor": {
      "description": "Specialized agent for photo editor development tasks",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 30,
      "temperature": 0.1,
      "color": "accent"
    }
  },
  "command": {
    "test-all": {
      "template": "Run all tests and fix failures",
      "agent": "general"
    },
    "build-android": {
      "template": "Build Android APK",
      "agent": "build"
    },
    "generate-sample": {
      "template": "Generate test sample image",
      "agent": "general"
    },
    "lint-fix": {
      "template": "Run lint with auto-fix",
      "agent": "general"
    },
    "typecheck": {
      "template": "Run TypeScript type checking",
      "agent": "general"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2048,
      "max_height": 2048,
      "max_base64_bytes": 5242880
    }
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "android/**/build/**",
      "www/**",
      "*.apk",
      ".kilo/worktrees/**"
    ]
  },
  "experimental": {
    "web_search": true,
    "privacy_mode": true,
    "reasoning_display": "preview",
    "terminal_command_display": "collapsed",
    "code_edit_display": "collapsed",
    "hide_prompt_training_models": true
  },
  "retention": {
    "enabled": false,
    "maxAgeDays": 30
  },
  "commit_message": {
    "prompt": "Generate a conventional commit message"
  },
  "remote_control": false,
  "terminal_command_display": "collapsed",
  "code_edit_display": "collapsed"
}
