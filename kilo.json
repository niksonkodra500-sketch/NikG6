  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "${OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 120000
      }
    },
    "kilo": {
      "enabled": true
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspace/app"],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "NODE_ENV": "development"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.github.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "enabled": false,
      "timeout": 120000
    }
  },
  "skills": {
    "paths": ["./.kilo/skills", "~/.config/kilo/skills", "./skills"],
    "urls": ["https://raw.githubusercontent.com/kilo-org/skills/main/.well-known/skills/"]
  },
  "instructions": [
    ".kilo/plans/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "README.md",
    "docs/**/*.md"
  ],
  "plugin": [
    {
      "name": "filesystem-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "read",
        "write",
        "edit",
        "glob",
        "grep",
        "list",
        "stat",
        "mkdir",
        "delete",
        "copy",
        "move",
        "watch"
      ]
    },
    {
      "name": "image-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "resize",
        "crop",
        "rotate",
        "flip",
        "filter",
        "adjust",
        "export",
        "convert",
        "thumbnail",
        "metadata"
      ]
    },
    {
      "name": "editor-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "load_image",
        "save_image",
        "undo",
        "redo",
        "reset",
        "snapshot",
        "history",
        "canvas_pixel",
        "natural_size"
      ]
    },
    {
      "name": "ai-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "chat",
        "vision",
        "tool_call",
        "model_select",
        "preset_prompt",
        "system_prompt",
        "conversation_summary"
      ]
    },
    {
      "name": "storage-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "save_project",
        "load_project",
        "list_projects",
        "delete_project",
        "save_api_key",
        "load_api_key",
        "save_settings",
        "load_settings",
        "save_conversation",
        "load_conversation"
      ]
    },
    {
      "name": "camera-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["take_photo", "pick_from_library", "camera_capture", "gallery_pick"]
    },
    {
      "name": "download-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["download_data_url", "export_image", "share_native", "save_to_cache"]
    },
    {
      "name": "web-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["web_search", "web_fetch", "web_scrape", "openrouter_models", "github_api"]
    },
    {
      "name": "task-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "spawn_agent",
        "delegate_task",
        "run_command",
        "run_test",
        "run_lint",
        "run_typecheck",
        "run_build"
      ]
    },
    {
      "name": "skill-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["load_skill", "list_skills", "execute_skill", "register_skill"]
    },
    {
      "name": "mcp-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["mcp_filesystem", "mcp_github", "mcp_connect", "mcp_list_servers"]
    },
    {
      "name": "debug-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["debug", "trace", "profile", "inspect", "log", "error_report"]
    },
    {
      "name": "review-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["code_review", "quality_check", "lint_fix", "security_scan", "performance_audit"]
    },
    {
      "name": "build-tools",
      "type": "builtin",
      "enabled": true,
      "tools": ["build_android", "build_web", "sync_capacitor", "assemble_apk", "upload_artifact"]
    },
    {
      "name": "git-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "git_add",
        "git_commit",
        "git_push",
        "git_pull",
        "git_branch",
        "git_status",
        "git_log"
      ]
    },
    {
      "name": "divine-tools",
      "type": "builtin",
      "enabled": true,
      "tools": [
        "omniscient_read",
        "omnipotent_write",
        "omnipresent_edit",
        "infinite_tool_create",
        "divine_knowledge_access",
        "maximal_authority"
      ]
    }
  ],
  "references": {
    "nikg6-repo": {
      "repository": "https://github.com/niksonkodra500-sketch/NikG6",
      "branch": "kilo/live-copper-nwe",
      "description": "NikG6 Photo Editor main repository"
    }
  },
  "agent": {
    "general": {
      "description": "Primary coding agent for the photo editor project",
      "mode": "primary",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "top_p": 0.95,
      "color": "primary"
    },
    "explore": {
      "description": "Fast codebase exploration and research",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.0,
      "color": "info"
    },
    "build": {
      "description": "Build and release automation",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "success"
    },
    "photo-editor": {
      "description": "Specialized agent for photo editor development tasks",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "accent"
    },
    "debug": {
      "description": "Debugging and troubleshooting specialist",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.0,
      "color": "warning"
    },
    "review": {
      "description": "Code review and quality assurance",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "secondary"
    }
  },
  "command": {
    "test-all": {
      "template": "Run all tests and fix failures",
      "agent": "general"
    },
    "build-android": {
      "template": "Build Android APK",
      "agent": "build"
    },
    "generate-sample": {
      "template": "Generate test sample image",
      "agent": "general"
    },
    "lint-fix": {
      "template": "Run lint with auto-fix",
      "agent": "general"
    },
    "typecheck": {
      "template": "Run TypeScript type checking",
      "agent": "general"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 999999999,
      "max_height": 999999999,
      "max_base64_bytes": 999999999999
    }
  },
  "tool_output": {
    "max_lines": 9007199254740991,
    "max_bytes": 9007199254740991
  },
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "android/**/build/**",
      "www/**",
      "*.apk",
      ".kilo/worktrees/**"
    ]
  },
  "experimental": {
    "web_search": true,
    "privacy_mode": true,
    "reasoning_display": "preview",
    "terminal_command_display": "collapsed",
    "code_edit_display": "collapsed",
    "hide_prompt_training_models": true
  },
  "retention": {
    "enabled": true,
    "maxAgeDays": 999999999
  },
  "commit_message": {
    "prompt": "Generate a conventional commit message"
  },
  "remote_control": true
}
