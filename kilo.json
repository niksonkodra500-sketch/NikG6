{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "kilo/kilo-auto/free",
  "small_model": "kilo/kilo-auto/free",
  "default_agent": "general",
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 100,
    "preserve_recent_tokens": 32000,
    "reserved": 16000
  },
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "username": "niksonkodra500",
  "shell": "bash",
  "logLevel": "DEBUG",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "task": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "doom_loop": "allow",
    "notebook_read": "allow",
    "notebook_edit": "allow",
    "notebook_execute": "allow"
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "${OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 120000
      }
    },
    "kilo": {
      "enabled": true
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspace/app"],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "NODE_ENV": "development"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.github.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "enabled": false,
      "timeout": 120000
    }
  },
  "skills": {
    "paths": ["./.kilo/skills", "~/.config/kilo/skills", "./skills"],
    "urls": ["https://raw.githubusercontent.com/kilo-org/skills/main/.well-known/skills/"]
  },
  "instructions": [
    ".kilo/plans/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "README.md",
    "docs/**/*.md"
  ],
  "plugin": [],
  "references": {
    "nikg6-repo": {
      "repository": "https://github.com/niksonkodra500-sketch/NikG6",
      "branch": "kilo/live-copper-nwe",
      "description": "NikG6 Photo Editor main repository"
    }
  },
  "agent": {
    "general": {
      "description": "Primary coding agent for the photo editor project",
      "mode": "primary",
      "model": "kilo/kilo-auto/free",
      "steps": 200,
      "temperature": 0.1,
      "top_p": 0.95,
      "color": "primary"
    },
    "explore": {
      "description": "Fast codebase exploration and research",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 50,
      "temperature": 0.0,
      "color": "info"
    },
    "build": {
      "description": "Build and release automation",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 100,
      "temperature": 0.1,
      "color": "success"
    },
    "photo-editor": {
      "description": "Specialized agent for photo editor development tasks",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 100,
      "temperature": 0.1,
      "color": "accent"
    },
    "debug": {
      "description": "Debugging and troubleshooting specialist",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 50,
      "temperature": 0.0,
      "color": "warning"
    },
    "review": {
      "description": "Code review and quality assurance",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 50,
      "temperature": 0.1,
      "color": "secondary"
    }
  },
  "command": {
    "test-all": {
      "template": "Run all tests and fix failures",
      "agent": "general"
    },
    "build-android": {
      "template": "Build Android APK",
      "agent": "build"
    },
    "generate-sample": {
      "template": "Generate test sample image",
      "agent": "general"
    },
    "lint-fix": {
      "template": "Run lint with auto-fix",
      "agent": "general"
    },
    "typecheck": {
      "template": "Run TypeScript type checking",
      "agent": "general"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 8192,
      "max_height": 8192,
      "max_base64_bytes": 20971520
    }
  },
  "tool_output": {
    "max_lines": 10000,
    "max_bytes": 204800
  },
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "android/**/build/**",
      "www/**",
      "*.apk",
      ".kilo/worktrees/**"
    ]
  },
  "experimental": {
    "web_search": true,
    "privacy_mode": true,
    "reasoning_display": "preview",
    "terminal_command_display": "collapsed",
    "code_edit_display": "collapsed",
    "hide_prompt_training_models": true
  },
  "retention": {
    "enabled": true,
    "maxAgeDays": 365
  },
  "commit_message": {
    "prompt": "Generate a conventional commit message"
  },
  "remote_control": true
}
