    "max_plugin_count": 9007199254740991,
    "max_skill_count": 9007199254740991,
    "max_command_count": 9007199254740991,
    "max_plan_count": 9007199254740991,
    "max_config_keys": 9007199254740991
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "${OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 120000
      }
    },
    "kilo": {
      "enabled": true
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/workspace/app"],
      "enabled": true,
      "timeout": 120000,
      "environment": {
        "NODE_ENV": "development"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.github.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "enabled": false,
      "timeout": 120000
    }
  },
  "skills": {
    "paths": ["./.kilo/skills", "~/.config/kilo/skills", "./skills"],
    "urls": ["https://raw.githubusercontent.com/kilo-org/skills/main/.well-known/skills/"]
  },
  "instructions": [
    ".kilo/plans/*.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "README.md",
    "docs/**/*.md"
  ],
  "plugin": [],
  "references": {
    "nikg6-repo": {
      "repository": "https://github.com/niksonkodra500-sketch/NikG6",
      "branch": "kilo/live-copper-nwe",
      "description": "NikG6 Photo Editor main repository"
    }
  },
  "agent": {
    "general": {
      "description": "Primary coding agent for the photo editor project",
      "mode": "primary",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "top_p": 0.95,
      "color": "primary"
    },
    "explore": {
      "description": "Fast codebase exploration and research",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.0,
      "color": "info"
    },
    "build": {
      "description": "Build and release automation",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "success"
    },
    "photo-editor": {
      "description": "Specialized agent for photo editor development tasks",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "accent"
    },
    "debug": {
      "description": "Debugging and troubleshooting specialist",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.0,
      "color": "warning"
    },
    "review": {
      "description": "Code review and quality assurance",
      "mode": "subagent",
      "model": "kilo/kilo-auto/free",
      "steps": 999999999,
      "temperature": 0.1,
      "color": "secondary"
    }
  },
  "command": {
    "test-all": {
      "template": "Run all tests and fix failures",
      "agent": "general"
    },
    "build-android": {
      "template": "Build Android APK",
      "agent": "build"
    },
    "generate-sample": {
      "template": "Generate test sample image",
      "agent": "general"
    },
    "lint-fix": {
      "template": "Run lint with auto-fix",
      "agent": "general"
    },
    "typecheck": {
      "template": "Run TypeScript type checking",
      "agent": "general"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 999999999,
      "max_height": 999999999,
      "max_base64_bytes": 999999999999
    }
  },
  "tool_output": {
    "max_lines": 999999999,
    "max_bytes": 999999999999
  },
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "android/**/build/**",
      "www/**",
      "*.apk",
      ".kilo/worktrees/**"
    ]
  },
  "experimental": {
    "web_search": true,
    "privacy_mode": true,
    "reasoning_display": "preview",
    "terminal_command_display": "collapsed",
    "code_edit_display": "collapsed",
    "hide_prompt_training_models": true
  },
  "retention": {
    "enabled": true,
    "maxAgeDays": 999999999
  },
  "commit_message": {
    "prompt": "Generate a conventional commit message"
  },
  "remote_control": true
}
